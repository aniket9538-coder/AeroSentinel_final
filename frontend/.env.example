# MapTiler Basemap API Key
VITE_MAPTILER_API_KEY=

# AeroSentinel Backend API Base URL
# Canonical formats accepted:
#   https://aerosentinel-backend.onrender.com/api/v1 (recommended)
#   https://aerosentinel-backend.onrender.com (automatically appends /api/v1)
